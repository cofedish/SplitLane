<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The unprivileged half of SplitLane.

    It runs as the interactive user and deliberately does not request elevation: everything that
    needs administrative rights lives behind the engine's control channel. An app that asked for
    elevation would be an app whose entire UI surface runs as administrator, which is a much larger
    thing to get right than a named pipe with eleven message kinds.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SplitLane.App</RootNamespace>
    <AssemblyName>SplitLane</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\SplitLane.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SplitLane.Core\SplitLane.Core.csproj" />
  </ItemGroup>

  <!--
    ProtectedData needs no package reference here: WPF pulls in Microsoft.WindowsDesktop.App, which
    already carries it. The engine, which is not a desktop app, does need the package.
  -->


  <!--
    Application identity is read by linked source, not a project: stamp, Authenticode, hash and
    package family in Shared\ImageInspection, the evidence built from them in Shared\Identity. A new
    assembly would have to be added to the installer, and the app and the engine must compute
    byte-identical identities from the same file - one source compiled into both guarantees that.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reading the engine service's state, so "not running" can say what to do about it. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

</Project>
