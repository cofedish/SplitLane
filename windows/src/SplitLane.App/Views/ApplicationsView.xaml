<UserControl x:Class="SplitLane.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SplitLane.App.Infrastructure"
             xmlns:vm="clr-namespace:SplitLane.App.ViewModels"
             xmlns:models="clr-namespace:SplitLane.Core.Models;assembly=SplitLane.Core"
             xmlns:services="clr-namespace:SplitLane.App.Services">

    <Grid>
        <!-- ==== Rule list ================================================================== -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,10,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Summary}"
                           AutomationProperties.AutomationId="ApplicationsSummary"
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,20,0"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Style="{StaticResource Field}" Width="220"
                             AutomationProperties.AutomationId="RuleFilter"
                             infra:Placeholder.Text="Filter by name or path"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Add application" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.AutomationId="AddApplicationButton"
                            Command="{Binding OpenPickerCommand}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!--
                Its own row. It used to share the header's, bottom-aligned, which drew it over the
                summary and the filter box the moment it appeared.
            -->
            <StackPanel Grid.Row="1">
                <!--
                    A rule that matches nothing leaves the application it names quietly going DIRECT,
                    and one whose file has been replaced has its connections refused. Nothing else in
                    the interface would report either, which is exactly what makes them worth a banner
                    rather than a subtle mark.
                -->
                <Border Margin="0,0,10,16" Padding="15,12" CornerRadius="10"
                        Background="{DynamicResource WarningTintBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        Visibility="{Binding HasStaleRules, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding StaleSummary}"
                               AutomationProperties.AutomationId="StaleRulesBanner"
                               FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>

                <!--
                    Until conversion finishes the rows still show the old rules and their old warnings;
                    saying so is what makes those warnings disappearing read as a fix, not a flicker.
                -->
                <TextBlock Margin="0,0,10,16" Style="{StaticResource BodyText}" FontSize="12.5"
                           AutomationProperties.AutomationId="MigrationStatus"
                           Text="Checking rules recorded by path, so they can recognise their applications by signature or package instead…"
                           Visibility="{Binding IsMigrating, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>

            <!-- Empty state -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="40" VerticalAlignment="Top"
                    Margin="0,0,10,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Nothing is in the proxy lane" FontSize="17" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource BodyText}" MaxWidth="440" TextAlignment="Center"
                               Margin="0,10,0,0" HorizontalAlignment="Center"
                               Text="Every application on this machine is currently DIRECT. Add one to route it through the proxy — everything else is left alone, its traffic passed through unmodified." />
                    <Button Content="Add application" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Margin="0,20,0,0"
                            AutomationProperties.AutomationId="AddApplicationEmptyButton"
                            Command="{Binding OpenPickerCommand}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsed}}">
                <ItemsControl ItemsSource="{Binding VisibleRules}" Margin="0,0,0,28">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppRuleViewModel}">
                            <Border Style="{StaticResource InteractiveCard}" Padding="18,16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Lane badge: the word first, the colour second. -->
                                    <Border Grid.Column="0" Style="{StaticResource Badge}"
                                            Width="80" Padding="0,5"
                                            Background="{Binding LaneLabel, Converter={StaticResource LaneTint}}"
                                            VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{Binding LaneLabel}" Style="{StaticResource BadgeText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding LaneLabel, Converter={StaticResource LaneBrush}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding ExecutablePath}"
                                                   Style="{StaticResource MonoText}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExecutablePath}" />

                                        <!--
                                            How the application is recognised, then what the rule
                                            covers: the first is what survives an update, the second
                                            is what the Helpers box changes. The publisher is part of
                                            the first line now, in full - it used to be a badge of its
                                            own, cut at the first comma.
                                        -->
                                        <TextBlock Text="{Binding IdentitySummary}"
                                                   AutomationProperties.AutomationId="RuleIdentity"
                                                   FontSize="11.5" Margin="0,10,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding IdentityDetail}" />

                                        <TextBlock Text="{Binding MatchSummary}"
                                                   FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding MatchTooltip}" />

                                        <!--
                                            W-4, and what replaced most of it: the one most important
                                            thing about this rule. Tinted by how much it matters - a
                                            note on what migration did is not a warning, and a rule
                                            that matches nothing is more than one.
                                        -->
                                        <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="7"
                                                Visibility="{Binding HasAdvice,
                                                             Converter={StaticResource BoolToVisible}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Attention}"
                                                                     Value="{x:Static vm:RuleAttention.Note}">
                                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Attention}"
                                                                     Value="{x:Static vm:RuleAttention.Stopped}">
                                                            <Setter Property="Background" Value="{DynamicResource BlockedTintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Top"
                                                         Margin="0,6,9,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Attention}"
                                                                             Value="{x:Static vm:RuleAttention.Note}">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Attention}"
                                                                             Value="{x:Static vm:RuleAttention.Stopped}">
                                                                    <Setter Property="Fill" Value="{DynamicResource BlockedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Grid.Column="1" Text="{Binding AdviceText}"
                                                           AutomationProperties.AutomationId="RuleWarning"
                                                           FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           MaxWidth="520" HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />

                                                <!--
                                                    Beside the sentence that asks for it, not with the
                                                    row's other controls: it is the remedy for this
                                                    message, and it goes when the message does.
                                                -->
                                                <Button Grid.Column="2" Content="Select again"
                                                        Style="{StaticResource QuietButton}"
                                                        Padding="12,6" Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.AutomationId="ReselectButton"
                                                        Visibility="{Binding CanReselect,
                                                                     Converter={StaticResource BoolToVisible}}"
                                                        Command="{Binding DataContext.ReselectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!--
                                        Controls in a two-row grid so every label sits on one
                                        baseline and every control on the next. Aligning them with
                                        per-control margins drifted the moment a label changed.
                                    -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Lane"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  Style="{StaticResource Dropdown}" Width="112"
                                                  Height="36" Margin="0,0,18,0"
                                                  AutomationProperties.AutomationId="LaneSelector"
                                                  SelectedValue="{Binding Action}"
                                                  SelectedValuePath="Content">
                                            <ComboBoxItem Content="{x:Static models:RouteAction.Proxy}" />
                                            <ComboBoxItem Content="{x:Static models:RouteAction.Direct}" />
                                            <ComboBoxItem Content="{x:Static models:RouteAction.Block}" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Helpers"
                                                   Style="{StaticResource FieldLabel}" />
                                        <CheckBox Grid.Row="1" Grid.Column="1"
                                                  Style="{StaticResource Check}"
                                                  Content="Include folder"
                                                  Height="36" Margin="0,0,20,0"
                                                  VerticalContentAlignment="Center"
                                                  AutomationProperties.AutomationId="IncludeFamily"
                                                  IsChecked="{Binding IncludesFamily}"
                                                  IsEnabled="{Binding SupportsFamilyMatching}"
                                                  ToolTip="{Binding MatchTooltip}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Enabled"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ToggleButton Grid.Row="1" Grid.Column="2"
                                                      Style="{StaticResource Switch}"
                                                      Margin="0,5,22,5"
                                                      AutomationProperties.AutomationId="RuleEnabled"
                                                      IsChecked="{Binding IsEnabled}" />

                                        <Button Grid.Row="1" Grid.Column="3" Content="Remove"
                                                Style="{StaticResource DangerButton}"
                                                Height="36" VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="RemoveRuleButton"
                                                Command="{Binding DataContext.RemoveCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ==== Picker overlay ============================================================= -->

        <Grid Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisible}}">
            <Rectangle Fill="{DynamicResource WindowScrimBrush}" />

            <Border Width="660" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                </Border.Effect>

                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Add an application" FontSize="17" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Button Content="Close" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Right"
                                AutomationProperties.AutomationId="ClosePickerButton"
                                Command="{Binding ClosePickerCommand}" />
                    </Grid>

                    <TextBox Grid.Row="1" Style="{StaticResource Field}" Margin="0,16,0,12"
                             AutomationProperties.AutomationId="PickerFilter"
                             infra:Placeholder.Text="Search running applications"
                             Text="{Binding PickerFilter, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Text="Scanning running processes…"
                               Style="{StaticResource BodyText}" VerticalAlignment="Top"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}">
                        <ItemsControl ItemsSource="{Binding VisibleCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ApplicationCandidate}">
                                    <Border Background="Transparent" CornerRadius="7" Padding="12,10" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MaxWidth="330" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                               FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                                            CornerRadius="4" Padding="6,2" Margin="9,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasProcesses,
                                                                         Converter={StaticResource BoolToVisible}}">
                                                        <TextBlock Text="{Binding ProcessLabel}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFaintBrush}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}"
                                                           FontSize="11" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="16,7" VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="AddCandidateButton"
                                                    Command="{Binding DataContext.AddCandidateCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" MaxWidth="380"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="Not running right now? Pick the executable from disk instead." />
                        <Button Content="Browse for .exe…" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                AutomationProperties.AutomationId="BrowseExeButton"
                                Command="{Binding BrowseCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
