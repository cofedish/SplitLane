<UserControl x:Class="SplitLane.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,28" MaxWidth="820" HorizontalAlignment="Left">

            <!-- ==== Appearance ============================================================= -->

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />

                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                               Text="Applied as you choose it. Following Windows means following it afterwards too, not only at startup." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <RadioButton Style="{StaticResource Segment}" Content="Follow Windows" GroupName="Theme" Margin="0,0,22,0"
                                     AutomationProperties.AutomationId="ThemeSystem"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="Theme" Margin="0,0,22,0"
                                     AutomationProperties.AutomationId="ThemeLight"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                     AutomationProperties.AutomationId="ThemeDark"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                               AutomationProperties.AutomationId="ThemeSummary"
                               Text="{Binding ThemeSummary}" />
                </StackPanel>
            </Border>

            <!-- ==== Divert layer =========================================================== -->

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Divert layer" Style="{StaticResource CardTitle}" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <!-- Grey by default: nothing running is neither healthy nor broken. -->
                                        <Setter Property="Fill" Value="{DynamicResource DirectBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriverIsHealthy}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource ProxyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DriverIsMissing}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DriverStatus}"
                                       AutomationProperties.AutomationId="DriverStatus"
                                       FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="7"
                            Padding="14,12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="How this differs from the macOS build" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,7,0,0"
                                       Text="macOS hands SplitLane each new connection and lets the kernel keep the ones it does not want. Windows has no equivalent, so the engine sees outbound packets and reinjects the ones it is not interested in byte for byte. Unselected applications are unmodified, but unlike on macOS they are not untouched — and saying otherwise would be dishonest." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==== Diagnostics ============================================================ -->

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Log every DIRECT decision" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,5,0,0"
                                       Text="Off by default, and worth leaving off. The engine sees every outbound connection on this machine, so turning this on makes the log a record of everything you do — and a very large one." />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      AutomationProperties.AutomationId="DirectLoggingSwitch"
                                      IsChecked="{Binding LogsDirectFlows}" />
                    </Grid>

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Redirect listener port" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Field}" Width="160" HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="RedirectPort"
                                 Text="{Binding RedirectPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding RedirectPortHint}" Style="{StaticResource BodyText}"
                                   FontSize="12" Margin="0,8,0,0" MaxWidth="600" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==== Storage ================================================================ -->

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource CardTitle}" />

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Configuration" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <TextBlock Text="{Binding ConfigurationPath}" Style="{StaticResource MonoText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,120,0" />
                            <Button Content="Show" Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="ShowConfigButton"
                                    Command="{Binding OpenConfigurationFolderCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Engine log" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource MonoText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,120,0" />
                            <Button Content="Show" Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="ShowLogButton"
                                    Command="{Binding OpenLogCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Control channel" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ControlChannel}" Style="{StaticResource MonoText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,16,0,0"
                               Text="Configuration is machine-wide because the divert layer is machine-wide. On a shared computer, every account's rules are visible to every other account." />
                </StackPanel>
            </Border>

            <!-- ==== About ================================================================== -->

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SplitLane for Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                   Style="{StaticResource MonoText}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                               Text="Per-application network routing. Put selected applications in a proxy lane; leave everything else alone." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
