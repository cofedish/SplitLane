<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The elevated half of SplitLane. This is the Windows counterpart of the macOS system extension:
    it is the only component that sees packets, the only one that needs administrative rights, and
    the only one linked against WinDivert.

    It deliberately has no UI, no window, and no way to be driven except the named-pipe control
    channel, whose message vocabulary is a closed enum in SplitLane.Core.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SplitLane.Engine</RootNamespace>
    <AssemblyName>SplitLane.Engine</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The divert layer is 64-bit only; WinDivert ships no 32-bit driver for modern Windows. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SplitLane.Core\SplitLane.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SplitLane.Engine.Tests" />
  </ItemGroup>

  <!--
    WinDivert.dll and its .sys are fetched by tools/fetch-windivert.ps1 rather than committed. They
    are a signed third-party kernel driver; vendoring a driver binary in a source repository is a
    supply-chain decision nobody should make implicitly.
  -->
  <ItemGroup>
    <None Include="..\..\runtime\windivert\**\*" Condition="Exists('..\..\runtime\windivert')">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <!--
      ServiceBase. Microsoft's own package rather than a hand-written service control dispatcher:
      the protocol has timeouts and status transitions that are unpleasant to get wrong, and getting
      them wrong shows up as a service stuck in "Starting" with nothing in any log.
    -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

</Project>
