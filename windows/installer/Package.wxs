<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    SplitLane for Windows installer.

    Three things this deliberately does NOT do:

      1. It does not bundle WinDivert. The driver is third-party, dual-licensed, and this repository
         has not chosen a licence of its own yet — redistributing someone else's kernel driver from
         an unlicensed project is not a decision an installer should make quietly. The fetch script
         is installed alongside instead, and the engine's preflight mode points at it. See ADR W-0001.

      2. It does not install a shortcut for the engine. It used to, and that shortcut was the whole
         problem: starting SplitLane meant right-clicking one executable to run it as administrator
         and then opening a second one. The engine is a service now, so there is one thing to open.

      3. It carries no licence dialog, because the project has not chosen a licence. Every stock WiX
         UI set includes one, so this ships with the basic MSI progress UI rather than presenting
         terms that do not exist.
  -->

  <Package Name="SplitLane"
           Manufacturer="SplitLane"
           Version="$(BuildVersion)"
           UpgradeCode="8C6A7B4E-2D31-4F0A-9E77-5B1C0D2A9F14"
           Scope="perMachine"
           Compressed="yes">

    <!-- Newer builds replace older ones in place rather than accumulating side by side. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of SplitLane is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cofedish/SplitLane" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      64-bit only. WinDivert ships no 32-bit driver that loads on a modern 64-bit Windows, so a
      32-bit install could never divert anything.
    -->
    <Launch Condition="VersionNT64" Message="SplitLane requires 64-bit Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SplitLane">
        <!--
          The engine goes in its own subdirectory. Both applications are published self-contained,
          so they carry overlapping copies of the .NET runtime; installed side by side in one folder
          they would fight over the same file names.
        -->
        <Directory Id="EngineFolder" Name="Engine" />
        <Directory Id="ToolsFolder" Name="Tools" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="SplitLane" />
    </StandardDirectory>

    <Feature Id="Main" Title="SplitLane" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="EngineFiles" />
      <ComponentGroupRef Id="ToolFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <!--
      Globbed rather than listed. A self-contained publish is a couple of hundred files and the set
      changes with every SDK update; a hand-written manifest would be wrong by the next runtime
      release, and wrong in the way that ships a broken installer.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AppPublishDir)\**" />
    </ComponentGroup>

    <!--
      The engine executable is declared on its own so a service can be hung off it; everything else
      it needs is globbed as before. A <Files> element generates its own components, and there is
      nowhere in one of those to say "and this is a service".
    -->
    <ComponentGroup Id="EngineFiles" Directory="EngineFolder">
      <Files Include="$(EnginePublishDir)\**">
        <Exclude Files="$(EnginePublishDir)\SplitLane.Engine.exe" />
      </Files>

      <Component Id="EngineService" Guid="B4E7C1A9-3D52-4F86-A0B3-7C9E5D1F2A48">
        <File Id="EngineExecutable" Source="$(EnginePublishDir)\SplitLane.Engine.exe" KeyPath="yes" />

        <!--
          LocalSystem, and that is what lets the application stay unelevated. The control channel was
          built for this arrangement from the start: its ACL grants LocalSystem full control and the
          interactive user read and write, so neither side gains anything from the other.

          Started automatically, so routing survives a reboot and a logout - which the old arrangement,
          an engine launched by hand into a user's session, could not.
        -->
        <ServiceInstall Id="EngineServiceInstall"
                        Name="SplitLane"
                        DisplayName="SplitLane routing engine"
                        Description="Routes traffic from selected applications through the configured proxy. Applications that are not selected are left alone."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="--service --no-console-log"
                        Vital="yes" />

        <ServiceControl Id="EngineServiceControl"
                        Name="SplitLane"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ToolFiles" Directory="ToolsFolder">
      <Files Include="$(ToolsDir)\fetch-windivert.ps1" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="AppShortcut" Guid="1F5B9C22-77A4-4B60-93D1-6E0F4A8C2B55">
        <Shortcut Id="AppStartMenu"
                  Name="SplitLane"
                  Description="Per-application network routing"
                  Target="[INSTALLFOLDER]SplitLane.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SplitLane" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!--
        The divert driver is fetched after installation, never shipped in the package (ADR W-0001),
        so Windows does not know the installer is responsible for it and an uninstall leaves it
        behind. Leaving a stray file would be untidy; leaving a kernel-mode driver on disk after
        someone has removed the program is a different thing, and it was still sitting in the Engine
        folder after a real uninstall was verified by hand.

        Named explicitly rather than by wildcard: this removes what fetch-windivert.ps1 puts there
        and nothing else.
      -->
      <Component Id="RemoveFetchedDriver" Directory="EngineFolder" Guid="*">
        <RemoveFile Id="RemoveWinDivertDll" Name="WinDivert.dll" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertSys64" Name="WinDivert64.sys" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertSys32" Name="WinDivert32.sys" On="uninstall" />
        <RemoveFolder Id="RemoveEngineFolder" Directory="EngineFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SplitLane" Name="driverCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
