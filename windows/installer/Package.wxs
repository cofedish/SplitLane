<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    SplitLane for Windows installer.

    Three things this deliberately does NOT do:

      1. It ships WinDivert, and its licence with it. The driver is third-party and dual-licensed
         under LGPL v3 or GPL v2; the terms are installed unmodified next to the binaries and named
         in THIRD-PARTY-NOTICES.txt at the root. It used to be fetched by hand after installing,
         which meant installing SplitLane did not give you a working SplitLane. See ADR W-0009.

      2. It does not install a shortcut for the engine. It used to, and that shortcut was the whole
         problem: starting SplitLane meant right-clicking one executable to run it as administrator
         and then opening a second one. The engine is a service now, so there is one thing to open.

      3. It carries no licence dialog, because the project has not chosen a licence. Every stock WiX
         UI set includes one, so this ships with the basic MSI progress UI rather than presenting
         terms that do not exist.
  -->

  <Package Name="SplitLane"
           Manufacturer="SplitLane"
           Version="$(BuildVersion)"
           UpgradeCode="8C6A7B4E-2D31-4F0A-9E77-5B1C0D2A9F14"
           Scope="perMachine"
           Compressed="yes">

    <!-- Newer builds replace older ones in place rather than accumulating side by side. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of SplitLane is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cofedish/SplitLane" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      64-bit only. WinDivert ships no 32-bit driver that loads on a modern 64-bit Windows, so a
      32-bit install could never divert anything.
    -->
    <Launch Condition="VersionNT64" Message="SplitLane requires 64-bit Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SplitLane">
        <!--
          The engine goes in its own subdirectory. Both applications are published self-contained,
          so they carry overlapping copies of the .NET runtime; installed side by side in one folder
          they would fight over the same file names.
        -->
        <Directory Id="EngineFolder" Name="Engine" />
        <Directory Id="ToolsFolder" Name="Tools" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="SplitLane" />
    </StandardDirectory>

    <Feature Id="Main" Title="SplitLane" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="EngineFiles" />
      <ComponentGroupRef Id="ToolFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <!--
      Globbed rather than listed. A self-contained publish is a couple of hundred files and the set
      changes with every SDK update; a hand-written manifest would be wrong by the next runtime
      release, and wrong in the way that ships a broken installer.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AppPublishDir)\**" />
    </ComponentGroup>

    <!--
      The engine executable is declared on its own so a service can be hung off it; everything else
      it needs is globbed as before. A <Files> element generates its own components, and there is
      nowhere in one of those to say "and this is a service".
    -->
    <ComponentGroup Id="EngineFiles" Directory="EngineFolder">
      <Files Include="$(EnginePublishDir)\**">
        <Exclude Files="$(EnginePublishDir)\SplitLane.Engine.exe" />
      </Files>

      <Component Id="EngineService" Guid="B4E7C1A9-3D52-4F86-A0B3-7C9E5D1F2A48">
        <File Id="EngineExecutable" Source="$(EnginePublishDir)\SplitLane.Engine.exe" KeyPath="yes" />

        <!--
          LocalSystem, and that is what lets the application stay unelevated. The control channel was
          built for this arrangement from the start: its ACL grants LocalSystem full control and the
          interactive user read and write, so neither side gains anything from the other.

          Started automatically, so routing survives a reboot and a logout - which the old arrangement,
          an engine launched by hand into a user's session, could not.
        -->
        <ServiceInstall Id="EngineServiceInstall"
                        Name="SplitLane"
                        DisplayName="SplitLane routing engine"
                        Description="Routes traffic from selected applications through the configured proxy. Applications that are not selected are left alone."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="--service --no-console-log"
                        Vital="yes" />

        <ServiceControl Id="EngineServiceControl"
                        Name="SplitLane"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Restarted when it fails: 5 s after the first failure, 10 s after the second, 30 s after every
      one after that, and the count forgotten after a day (86400 s) without one. Without this a crash
      left the service stopped - `sc qfailure SplitLane` on an installed machine listed no actions -
      and every selected application went DIRECT until somebody noticed. `failureflag 1` extends it
      to an engine that stops itself with a non-zero exit code, which the service manager otherwise
      treats like a stop somebody asked for. A stop somebody did ask for still stays stopped: the
      engine never sets ServiceBase.ExitCode, so it reports 0.

      Set with sc.exe, because neither WiX element can say this:

        - ServiceConfig and ServiceConfigFailureActions write the MsiServiceConfig tables, and the
          Windows Installer SDK documents MsiConfigureServices failure actions as "not working as
          expected", naming a custom action that runs sc.exe as the workaround. WiX 5.0.2 answers
          both elements with WIX1149, and warnings are errors here: tried, and the build stopped.
        - util:ServiceConfig does work, but it has one RestartServiceDelayInSeconds for all three
          actions and nothing for the failure flag, so it cannot express 5/10/30 or a non-zero exit.

      WixQuietExec rather than a bare exe action because it writes the command line and sc.exe's
      output into the installer log. Return="check", because a service installed without recovery
      is the defect this fixes; failing to configure it fails the install, as ServiceInstall does
      by being Vital.

      Deferred and not impersonated, so it runs as LocalSystem. After InstallServices and before
      StartServices, so the first start is already covered. On install and on repair ($EngineService
      is 3 for both), so a repair puts back settings that were cleared. A major upgrade removes the
      old product, service included, before this one installs, so it is an install here too. Nothing
      runs on uninstall: the service is deleted.
    -->
    <SetProperty Id="ConfigureEngineRecovery"
                 Value="&quot;[System64Folder]sc.exe&quot; failure SplitLane reset= 86400 actions= restart/5000/restart/10000/restart/30000"
                 Before="ConfigureEngineRecovery"
                 Sequence="execute" />
    <CustomAction Id="ConfigureEngineRecovery"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <SetProperty Id="ConfigureEngineRecoveryFlag"
                 Value="&quot;[System64Folder]sc.exe&quot; failureflag SplitLane 1"
                 Before="ConfigureEngineRecoveryFlag"
                 Sequence="execute" />
    <CustomAction Id="ConfigureEngineRecoveryFlag"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="ConfigureEngineRecovery" After="InstallServices" Condition="$EngineService = 3" />
      <Custom Action="ConfigureEngineRecoveryFlag" After="ConfigureEngineRecovery" Condition="$EngineService = 3" />
    </InstallExecuteSequence>

    <ComponentGroup Id="ToolFiles" Directory="ToolsFolder">
      <Files Include="$(ToolsDir)\fetch-windivert.ps1" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="AppShortcut" Guid="1F5B9C22-77A4-4B60-93D1-6E0F4A8C2B55">
        <Shortcut Id="AppStartMenu"
                  Name="SplitLane"
                  Description="Per-application network routing"
                  Target="[INSTALLFOLDER]SplitLane.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SplitLane" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!--
        The driver is part of the package now (ADR W-0009), so Windows removes it like any other
        installed file. This stays for the machine that fetched it by hand before upgrading, and for
        anyone who replaces it with their own build of the same version - which the LGPL entitles
        them to do, and which would otherwise leave a kernel-mode driver on disk after the program
        that brought it had been removed.

        Named explicitly rather than by wildcard: it takes what fetch-windivert.ps1 puts there and
        nothing else.
      -->
      <Component Id="RemoveFetchedDriver" Directory="EngineFolder" Guid="*">
        <RemoveFile Id="RemoveWinDivertDll" Name="WinDivert.dll" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertSys64" Name="WinDivert64.sys" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertSys32" Name="WinDivert32.sys" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertLicence" Name="WinDivert-LICENSE.txt" On="uninstall" />
        <RemoveFile Id="RemoveWinDivertVersion" Name="WinDivert-VERSION.txt" On="uninstall" />
        <RemoveFolder Id="RemoveEngineFolder" Directory="EngineFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SplitLane" Name="driverCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
